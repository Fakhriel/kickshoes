---
import DashboardLayout from "../layouts/DashboardLayout.astro";
import PageHeader from "../components/PageHeader.astro";
---

<DashboardLayout title="Order" activeNav="orders">
  <PageHeader heading="Order" sub="Daftar transaksi masuk" crumbs={[{ label: "Transaksi" }, { label: "Order" }]}>
    <button id="btn-export-orders" type="button" class="btn-secondary text-xs gap-1.5">
      <svg viewBox="0 0 24 24" fill="none" class="w-3.5 h-3.5" stroke="currentColor" stroke-width="1.75">
        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
        <polyline points="14 2 14 8 20 8"/><line x1="12" y1="18" x2="12" y2="12"/>
        <line x1="9" y1="15" x2="15" y2="15"/>
      </svg>
      Export PDF
    </button>
  </PageHeader>

  <!-- Filter -->
  <div class="flex flex-col sm:flex-row gap-3 mb-5">
    <input id="search-orders" type="search" placeholder="Cari order ID / nama pelanggan…" class="field-input sm:max-w-xs" />
    <select id="filter-status" class="field-input sm:w-40">
      <option value="">Semua Status</option>
      <option value="pending">Pending</option>
      <option value="paid">Dibayar</option>
      <option value="failed">Gagal</option>
      <option value="expired">Kadaluarsa</option>
      <option value="cancelled">Dibatalkan</option>
    </select>
  </div>

  <!-- Table -->
  <div class="panel overflow-hidden">
    <div class="overflow-x-auto">
      <table id="orders-table" class="data-table">
        <thead>
          <tr>
            <th>Order ID</th>
            <th>Pelanggan</th>
            <th class="hidden sm:table-cell">Tanggal</th>
            <th>Total</th>
            <th class="hidden md:table-cell">Kurir</th>
            <th>Status</th>
            <th class="text-right">Aksi</th>
          </tr>
        </thead>
        <tbody id="orders-body"></tbody>
      </table>
    </div>
    <div id="orders-empty" class="empty-state min-h-56">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <path d="M5.5 8H18.5L19.5 21H4.5L5.5 8Z"/>
        <path d="M8.5 8V6C8.5 4.067 9.567 3 12 3C14.433 3 15.5 4.067 15.5 6V8"/>
      </svg>
      <p>Belum ada order masuk</p>
    </div>
    <div class="flex items-center justify-between px-4 py-3 border-t border-hairline">
      <span data-orders-count class="font-mono text-[10px] text-smoke">0 order</span>
      <div class="flex items-center gap-1">
        <button type="button" class="btn-secondary text-xs px-2.5 py-1.5" disabled>←</button>
        <span class="font-mono text-xs px-3 py-1.5 border border-hairline">1</span>
        <button type="button" class="btn-secondary text-xs px-2.5 py-1.5" disabled>→</button>
      </div>
    </div>
  </div>

  <!-- Order Detail Drawer -->
  <div id="order-drawer" class="fixed inset-y-0 right-0 z-50 w-full sm:w-[420px] bg-paper border-l-2 border-ink translate-x-full transition-transform duration-300 ease-out flex flex-col">
    <div class="flex items-center justify-between px-5 py-4 border-b-2 border-ink shrink-0">
      <h2 class="font-display text-xl text-ink">Detail Order</h2>
      <button id="drawer-close" type="button" class="text-smoke hover:text-ink p-1">
        <svg viewBox="0 0 24 24" fill="none" class="w-5 h-5" stroke="currentColor" stroke-width="2">
          <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
      </button>
    </div>
    <div class="flex-1 overflow-y-auto p-5">
      <div id="drawer-content" class="empty-state min-h-40">
        <p>Pilih order untuk melihat detail</p>
      </div>
    </div>
  </div>
  <div id="drawer-overlay" class="fixed inset-0 bg-ink/40 z-40 hidden"></div>
</DashboardLayout>

<script>
  import { exportTableToPDF } from "../lib/export";
  import { adminApiFetch } from "../lib/auth";

  const apiUrl =
    document.getElementById("dashboard-root")?.dataset.apiUrl || "http://localhost:4000";

  interface AdminOrder {
    orderId: string;
    customerName: string;
    customerEmail: string;
    totalAmount: number;
    status: string;
    createdAt: string;
    productName: string;
    productSlug: string;
    size: string;
    color: string | null;
    quantity: number;
    shippingCost: number;
    pricePerItem: number;
    midtransTransactionId: string | null;
  }

  let allOrders: AdminOrder[] = [];

  const tbody = document.getElementById("orders-body") as HTMLTableSectionElement;
  const emptyState = document.getElementById("orders-empty") as HTMLDivElement;
  const countLabel = document.querySelector<HTMLSpanElement>("[data-orders-count]");
  const table = document.getElementById("orders-table") as HTMLTableElement;

  const STATUS_LABELS: Record<string, string> = {
    pending: "Pending",
    paid: "Dibayar",
    failed: "Gagal",
    expired: "Kadaluarsa",
    cancelled: "Dibatalkan",
  };
  const STATUS_CLASSES: Record<string, string> = {
    pending: "border-ink text-ink",
    paid: "border-ink bg-ink text-paper",
    failed: "border-signal text-signal",
    expired: "border-smoke text-smoke",
    cancelled: "border-smoke text-smoke",
  };

  function formatRupiah(value: number): string {
    return new Intl.NumberFormat("id-ID", {
      style: "currency", currency: "IDR", minimumFractionDigits: 0,
    }).format(value);
  }
  function formatDate(iso: string): string {
    return new Date(iso).toLocaleDateString("id-ID", {
      day: "2-digit", month: "short", year: "numeric",
    });
  }

  function renderTable(orders: AdminOrder[]): void {
    tbody.innerHTML = "";
    const isEmpty = orders.length === 0;
    table.classList.toggle("hidden", isEmpty);
    emptyState.classList.toggle("hidden", !isEmpty);
    if (countLabel) countLabel.textContent = `${orders.length} order`;

    orders.forEach((o) => {
      const statusLabel = STATUS_LABELS[o.status] ?? o.status;
      const statusClass = STATUS_CLASSES[o.status] ?? "border-smoke text-smoke";
      const tr = document.createElement("tr");
      tr.innerHTML = `
        <td class="font-mono text-xs">${o.orderId}</td>
        <td>
          <p class="font-semibold text-sm text-ink">${o.customerName}</p>
          <p class="font-mono text-[10px] text-smoke">${o.customerEmail}</p>
        </td>
        <td class="hidden sm:table-cell font-mono text-xs text-smoke">${formatDate(o.createdAt)}</td>
        <td class="font-mono text-xs">${formatRupiah(o.totalAmount)}</td>
        <td class="hidden md:table-cell font-mono text-xs text-smoke">—</td>
        <td>
          <span class="font-mono text-[10px] uppercase tracking-wide px-2 py-0.5 border-2 ${statusClass}">
            ${statusLabel}
          </span>
        </td>
        <td class="text-right">
          <button type="button" class="btn-view-order text-xs px-2 py-1 hover:underline" data-order-id="${o.orderId}">
            Detail
          </button>
        </td>
      `;
      tbody.appendChild(tr);
    });

    tbody.querySelectorAll<HTMLButtonElement>(".btn-view-order").forEach((btn) => {
      btn.addEventListener("click", () => {
        const order = allOrders.find((o) => o.orderId === btn.dataset.orderId);
        if (order) openDrawer(order);
      });
    });
  }

  function applyFilters(): void {
    const keyword = (document.getElementById("search-orders") as HTMLInputElement)?.value
      .trim().toLowerCase() ?? "";
    const status = (document.getElementById("filter-status") as HTMLSelectElement)?.value ?? "";

    const filtered = allOrders.filter((o) => {
      if (keyword && !o.orderId.toLowerCase().includes(keyword) &&
          !o.customerName.toLowerCase().includes(keyword)) return false;
      if (status && o.status !== status) return false;
      return true;
    });
    renderTable(filtered);
  }

  async function loadOrders(): Promise<void> {
    try {
      const res = await adminApiFetch(`${apiUrl}/api/payment/admin/orders`);
      const json = await res.json();
      if (!res.ok) {
        window.showToast?.(json.error ?? "Gagal memuat order", "error");
        return;
      }
      allOrders = json.data ?? [];
      applyFilters();
    } catch {
      window.showToast?.("Tidak bisa terhubung ke server", "error");
    }
  }

  document.getElementById("search-orders")?.addEventListener("input", applyFilters);
  document.getElementById("filter-status")?.addEventListener("change", applyFilters);

  // ─── Drawer detail order ────────────────────────────────────────
  const drawer = document.getElementById("order-drawer");
  const overlay = document.getElementById("drawer-overlay");
  const drawerContent = document.getElementById("drawer-content");

  function openDrawer(order: AdminOrder): void {
    if (drawerContent) {
      drawerContent.innerHTML = `
        <div class="space-y-4">
          <div>
            <p class="font-mono text-[10px] text-smoke uppercase tracking-wide mb-1">Order ID</p>
            <p class="font-mono text-xs text-ink break-all">${order.orderId}</p>
          </div>
          <div>
            <p class="font-mono text-[10px] text-smoke uppercase tracking-wide mb-1">Produk</p>
            <p class="font-body text-sm text-ink font-semibold">${order.productName}</p>
            <p class="font-mono text-xs text-smoke">Ukuran: ${order.size}${order.color ? ` / ${order.color}` : ""} × ${order.quantity}</p>
          </div>
          <div class="grid grid-cols-2 gap-3">
            <div>
              <p class="font-mono text-[10px] text-smoke uppercase tracking-wide mb-1">Harga Satuan</p>
              <p class="font-mono text-sm text-ink">${formatRupiah(order.pricePerItem)}</p>
            </div>
            <div>
              <p class="font-mono text-[10px] text-smoke uppercase tracking-wide mb-1">Ongkir</p>
              <p class="font-mono text-sm text-ink">${formatRupiah(order.shippingCost)}</p>
            </div>
          </div>
          <div>
            <p class="font-mono text-[10px] text-smoke uppercase tracking-wide mb-1">Total</p>
            <p class="font-body text-xl text-ink font-bold">${formatRupiah(order.totalAmount)}</p>
          </div>
          <hr class="border-hairline" />
          <div>
            <p class="font-mono text-[10px] text-smoke uppercase tracking-wide mb-1">Pelanggan</p>
            <p class="font-body text-sm text-ink">${order.customerName}</p>
            <p class="font-mono text-xs text-smoke">${order.customerEmail}</p>
          </div>
          <div>
            <p class="font-mono text-[10px] text-smoke uppercase tracking-wide mb-1">Tanggal</p>
            <p class="font-mono text-xs text-ink">${formatDate(order.createdAt)}</p>
          </div>
          ${order.midtransTransactionId ? `
          <div>
            <p class="font-mono text-[10px] text-smoke uppercase tracking-wide mb-1">Transaction ID Midtrans</p>
            <p class="font-mono text-xs text-ink break-all">${order.midtransTransactionId}</p>
          </div>` : ""}
          <div>
            <p class="font-mono text-[10px] text-smoke uppercase tracking-wide mb-1">Status</p>
            <span class="font-mono text-[10px] uppercase tracking-wide px-2 py-0.5 border-2 ${STATUS_CLASSES[order.status] ?? "border-smoke text-smoke"}">
              ${STATUS_LABELS[order.status] ?? order.status}
            </span>
          </div>
        </div>
      `;
    }
    drawer?.classList.remove("translate-x-full");
    overlay?.classList.remove("hidden");
    document.body.style.overflow = "hidden";
  }

  function closeDrawer(): void {
    drawer?.classList.add("translate-x-full");
    overlay?.classList.add("hidden");
    document.body.style.overflow = "";
  }

  document.getElementById("drawer-close")?.addEventListener("click", closeDrawer);
  overlay?.addEventListener("click", closeDrawer);

  document.getElementById("btn-export-orders")?.addEventListener("click", () => {
    exportTableToPDF("orders-table", { title: "Daftar Order", subtitle: "Laporan transaksi STRIDE" });
  });

  loadOrders();
</script>