---
import ProductCard from "./ProductCard.astro";

export const prerender = false;

export interface Props {
  title?: string;
  subtitle?: string;
}

const { title = "Koleksi Terbaru", subtitle = "Dipilih untuk langkah berikutnya" } = Astro.props;

const API_URL = import.meta.env.PUBLIC_API_URL || "http://localhost:4000";

interface ProductListItem {
  id: string;
  slug: string;
  name: string;
  category: string;
  price: number;
  originalPrice?: number | null;
  image: string;
  badge?: "Baru" | "Diskon" | "Terlaris" | null;
  firstAvailableSize?: string | null;
}

let products: ProductListItem[] = [];
let fetchFailed = false;

try {
  const res = await fetch(`${API_URL}/api/products`);
  if (res.ok) {
    const json = await res.json();
    products = json.data ?? [];
  } else {
    fetchFailed = true;
  }
} catch (err) {
  console.error("[ProductGrid] gagal fetch backend:", err);
  fetchFailed = true;
}
---

<section id="produk" class="border-t border-ink bg-paper py-12 sm:py-16 md:py-20">
  <div class="max-w-full mx-auto px-4 sm:px-6 md:px-8 lg:px-12">
    <!-- Section header -->
    <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-3 sm:gap-6 mb-8 sm:mb-10 md:mb-12 pb-6 border-b border-hairline">
      <div>
        <p class="font-mono text-xs text-smoke uppercase tracking-wide mb-2">
          Katalog
        </p>
        <h2 class="font-display text-3xl sm:text-4xl md:text-5xl text-ink leading-none">
          {title}
        </h2>
      </div>
      <p class="font-body text-sm sm:text-base text-charcoal max-w-xs sm:text-right">
        {subtitle}
      </p>
    </div>

    <!-- Product grid -->
    {fetchFailed ? (
      <p class="font-mono text-sm text-signal py-12 text-center">
        Gagal memuat produk. Coba muat ulang halaman.
      </p>
    ) : products.length === 0 ? (
      <p class="font-mono text-sm text-smoke py-12 text-center">
        Belum ada produk tersedia saat ini.
      </p>
    ) : (
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3 sm:gap-4 md:gap-6">
        {products.map((product) => (
          <ProductCard
            id={product.id}
            slug={product.slug}
            name={product.name}
            category={product.category}
            price={product.price}
            originalPrice={product.originalPrice}
            image={product.image}
            badge={product.badge}
            firstAvailableSize={product.firstAvailableSize}
          />
        ))}
      </div>
    )}
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { getAuthState } from "../lib/AuthState";
  import { addToCart, addToWishlist, ApiError } from "../lib/CartWishlist";

  let productGridInitialized = false;

  function initProductGrid(): void {
    if (productGridInitialized) return;

    const grid = document.getElementById("produk");
    if (!grid) return;

    productGridInitialized = true;

    const apiUrl =
      document.getElementById("navbar")?.getAttribute("data-api-url") || "http://localhost:4000";

    function pulseBadge(el: HTMLElement): void {
      gsap.fromTo(el, { scale: 1 }, { scale: 1.15, duration: 0.15, yoyo: true, repeat: 1, ease: "power1.inOut" });
    }

    // Navbar.astro mendengarkan event ini untuk menambah angka badge
    // cart/wishlist-nya sendiri tanpa perlu kedua file saling import.
    function dispatchCountEvent(action: "cart" | "wishlist"): void {
      window.dispatchEvent(new CustomEvent(`stride:${action}-changed`, { bubbles: true }));
    }

    // Navbar.astro mendengarkan event ini untuk memunculkan modal "Perlu Login"
    // yang sudah ada di sana, supaya tidak ada modal auth yang terduplikasi.
    function requireAuth(action: "cart" | "wishlist"): void {
      window.dispatchEvent(
        new CustomEvent("stride:auth-required", { bubbles: true, detail: { action } })
      );
    }

    // Toast lokal sederhana — grid produk muncul di banyak halaman (index,
    // pria, wanita, koleksi-baru) jadi tidak menumpang ke #toast milik Navbar
    // supaya tidak ada ketergantungan urutan render antar komponen.
    function showGridToast(message: string, isError = false): void {
      let toast = document.getElementById("grid-toast");
      if (!toast) {
        toast = document.createElement("div");
        toast.id = "grid-toast";
        toast.className =
          "fixed bottom-6 sm:bottom-8 left-4 sm:left-6 max-w-xs px-4 sm:px-6 py-3 sm:py-4 rounded-sm shadow-lg translate-y-24 opacity-0 z-[110] font-body text-sm sm:text-base text-paper";
        document.body.appendChild(toast);
      }
      toast.classList.toggle("bg-signal", isError);
      toast.classList.toggle("bg-ink", !isError);
      toast.textContent = message;
      gsap.to(toast, { translateY: 0, opacity: 1, duration: 0.3, ease: "back.out(1.7)" });
      setTimeout(() => {
        gsap.to(toast, { translateY: 96, opacity: 0, duration: 0.3, ease: "power2.in" });
      }, 2500);
    }

    grid.querySelectorAll<HTMLElement>('[data-action="wishlist"]').forEach((btn) => {
      btn.addEventListener("click", async (e) => {
        e.preventDefault();

        if (!getAuthState().isAuthenticated) {
          requireAuth("wishlist");
          return;
        }

        const productId = btn.dataset.productId;
        if (!productId) return;

        try {
          await addToWishlist(apiUrl, productId);
          pulseBadge(btn);
          dispatchCountEvent("wishlist");
          showGridToast("Ditambahkan ke favorit");
        } catch (err) {
          const message = err instanceof ApiError ? err.message : "Gagal menambahkan ke favorit.";
          showGridToast(message, true);
        }
      });
    });

    grid.querySelectorAll<HTMLElement>('[data-action="cart"]').forEach((btn) => {
      btn.addEventListener("click", async (e) => {
        e.preventDefault();

        if (!getAuthState().isAuthenticated) {
          requireAuth("cart");
          return;
        }

        const productId = btn.dataset.productId;
        const size = btn.dataset.size;
        if (!productId) return;

        if (!size) {
          // Produk ini tidak punya stok ukuran apapun — arahkan ke halaman
          // detail supaya pesan "stok habis" jelas terlihat, daripada
          // pura-pura berhasil menambahkan item yang sebenarnya tidak ada stoknya.
          const card = btn.closest<HTMLElement>(".product-card");
          const link = card?.querySelector("a")?.getAttribute("href");
          showGridToast("Stok produk ini sedang habis.", true);
          if (link) {
            setTimeout(() => {
              window.location.href = link;
            }, 900);
          }
          return;
        }

        try {
          await addToCart(apiUrl, { productId, size, quantity: 1 });
          pulseBadge(btn);
          dispatchCountEvent("cart");
          showGridToast("Ditambahkan ke keranjang");
        } catch (err) {
          const message = err instanceof ApiError ? err.message : "Gagal menambahkan ke keranjang.";
          showGridToast(message, true);
        }
      });
    });
  }

  document.addEventListener("DOMContentLoaded", initProductGrid);
  document.addEventListener("astro:page-load", () => {
    productGridInitialized = false;
    initProductGrid();
  });

  if (document.readyState !== "loading") {
    initProductGrid();
  }
</script>