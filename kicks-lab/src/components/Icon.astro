---
// Custom SVG icon set — hand-picked paths, consistent stroke weight.
// No emoji, no external icon library — keeps bundle small & style consistent.
export interface Props {
  name:
    | "search"
    | "bag"
    | "user"
    | "heart"
    | "arrow-right"
    | "arrow-up-right"
    | "menu"
    | "close"
    | "chevron-down"
    | "chevron-left"
    | "chevron-right"
    | "stride-mark"
    | "instagram"
    | "tiktok"
    | "twitter"
    | "star"
    | "shield"
    | "truck"
    | "refresh"
    | "zoom-in"
    | "minus"
    | "plus"
    | "check";
  class?: string;
  strokeWidth?: number;
  id?: string;
}

const { name, class: className = "w-6 h-6", strokeWidth = 1.75, id } = Astro.props;
---

{name === "search" && (
  <svg viewBox="0 0 24 24" fill="none" class={className} id={id} xmlns="http://www.w3.org/2000/svg">
    <circle cx="10.5" cy="10.5" r="6.5" stroke="currentColor" stroke-width={strokeWidth} />
    <path d="M19.5 19.5L15.5 15.5" stroke="currentColor" stroke-width={strokeWidth} stroke-linecap="round" />
  </svg>
)}

{name === "bag" && (
  <svg viewBox="0 0 24 24" fill="none" class={className} id={id} xmlns="http://www.w3.org/2000/svg">
    <path d="M5.5 8H18.5L19.5 21H4.5L5.5 8Z" stroke="currentColor" stroke-width={strokeWidth} stroke-linejoin="round" />
    <path d="M8.5 8V6C8.5 4.067 9.567 3 12 3C14.433 3 15.5 4.067 15.5 6V8" stroke="currentColor" stroke-width={strokeWidth} stroke-linecap="round" />
  </svg>
)}

{name === "user" && (
  <svg viewBox="0 0 24 24" fill="none" class={className} id={id} xmlns="http://www.w3.org/2000/svg">
    <circle cx="12" cy="8" r="3.5" stroke="currentColor" stroke-width={strokeWidth} />
    <path d="M4.5 20C5.5 16 8 14 12 14C16 14 18.5 16 19.5 20" stroke="currentColor" stroke-width={strokeWidth} stroke-linecap="round" />
  </svg>
)}

{name === "heart" && (
  <svg viewBox="0 0 24 24" fill="none" class={className} id={id} xmlns="http://www.w3.org/2000/svg">
    <path d="M12 20C12 20 3.5 15.5 3.5 9.5C3.5 6.5 5.7 4.5 8.3 4.5C10 4.5 11.2 5.4 12 6.5C12.8 5.4 14 4.5 15.7 4.5C18.3 4.5 20.5 6.5 20.5 9.5C20.5 15.5 12 20 12 20Z" stroke="currentColor" stroke-width={strokeWidth} stroke-linejoin="round" />
  </svg>
)}

{name === "arrow-right" && (
  <svg viewBox="0 0 24 24" fill="none" class={className} id={id} xmlns="http://www.w3.org/2000/svg">
    <path d="M4 12H20" stroke="currentColor" stroke-width={strokeWidth} stroke-linecap="round" />
    <path d="M14 6L20 12L14 18" stroke="currentColor" stroke-width={strokeWidth} stroke-linecap="round" stroke-linejoin="round" />
  </svg>
)}

{name === "arrow-up-right" && (
  <svg viewBox="0 0 24 24" fill="none" class={className} id={id} xmlns="http://www.w3.org/2000/svg">
    <path d="M7 17L17 7" stroke="currentColor" stroke-width={strokeWidth} stroke-linecap="round" />
    <path d="M9 7H17V15" stroke="currentColor" stroke-width={strokeWidth} stroke-linecap="round" stroke-linejoin="round" />
  </svg>
)}

{name === "menu" && (
  <svg viewBox="0 0 24 24" fill="none" class={className} id={id} xmlns="http://www.w3.org/2000/svg">
    <path d="M4 7H20" stroke="currentColor" stroke-width={strokeWidth} stroke-linecap="round" />
    <path d="M4 12H20" stroke="currentColor" stroke-width={strokeWidth} stroke-linecap="round" />
    <path d="M4 17H20" stroke="currentColor" stroke-width={strokeWidth} stroke-linecap="round" />
  </svg>
)}

{name === "close" && (
  <svg viewBox="0 0 24 24" fill="none" class={className} id={id} xmlns="http://www.w3.org/2000/svg">
    <path d="M5 5L19 19" stroke="currentColor" stroke-width={strokeWidth} stroke-linecap="round" />
    <path d="M19 5L5 19" stroke="currentColor" stroke-width={strokeWidth} stroke-linecap="round" />
  </svg>
)}

{name === "chevron-down" && (
  <svg viewBox="0 0 24 24" fill="none" class={className} id={id} xmlns="http://www.w3.org/2000/svg">
    <path d="M5 9L12 16L19 9" stroke="currentColor" stroke-width={strokeWidth} stroke-linecap="round" stroke-linejoin="round" />
  </svg>
)}

{name === "stride-mark" && (
  <svg viewBox="0 0 24 24" fill="none" class={className} id={id} xmlns="http://www.w3.org/2000/svg">
    <ellipse cx="9" cy="6" rx="3" ry="4" transform="rotate(-15 9 6)" stroke="currentColor" stroke-width={strokeWidth} />
    <ellipse cx="16" cy="16" rx="3" ry="4" transform="rotate(15 16 16)" stroke="currentColor" stroke-width={strokeWidth} />
  </svg>
)}

{name === "instagram" && (
  <svg viewBox="0 0 24 24" fill="none" class={className} id={id} xmlns="http://www.w3.org/2000/svg">
    <rect x="3.5" y="3.5" width="17" height="17" rx="4.5" stroke="currentColor" stroke-width={strokeWidth} />
    <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width={strokeWidth} />
    <circle cx="17" cy="7" r="0.75" fill="currentColor" />
  </svg>
)}

{name === "tiktok" && (
  <svg viewBox="0 0 24 24" fill="none" class={className} id={id} xmlns="http://www.w3.org/2000/svg">
    <path d="M14 4V14.5C14 16.5 12.5 18 10.5 18C8.5 18 7 16.5 7 14.5C7 12.5 8.5 11 10.5 11" stroke="currentColor" stroke-width={strokeWidth} stroke-linecap="round" />
    <path d="M14 4C14 6.5 16 8.5 18.5 8.5" stroke="currentColor" stroke-width={strokeWidth} stroke-linecap="round" />
  </svg>
)}

{name === "twitter" && (
  <svg viewBox="0 0 24 24" fill="none" class={className} id={id} xmlns="http://www.w3.org/2000/svg">
    <path d="M4 4L11 13.5L4.5 20H6.5L12.2 14.8L17 20H20L12.7 10.9L18.7 4H16.7L11.5 8.7L7 4H4Z" stroke="currentColor" stroke-width={strokeWidth * 0.6} stroke-linejoin="round" fill="currentColor" />
  </svg>
)}

{name === "star" && (
  <svg viewBox="0 0 24 24" fill="none" class={className} id={id} xmlns="http://www.w3.org/2000/svg">
    <path d="M12 3.5L14.5 9.5L21 10.2L16 14.5L17.5 21L12 17.3L6.5 21L8 14.5L3 10.2L9.5 9.5L12 3.5Z" stroke="currentColor" stroke-width={strokeWidth} stroke-linejoin="round" />
  </svg>
)}

{name === "shield" && (
  <svg viewBox="0 0 24 24" fill="none" class={className} id={id} xmlns="http://www.w3.org/2000/svg">
    <path d="M12 3.5L19 6.5V11.5C19 16 16 19 12 20.5C8 19 5 16 5 11.5V6.5L12 3.5Z" stroke="currentColor" stroke-width={strokeWidth} stroke-linejoin="round" />
    <path d="M9 11.5L11.3 13.8L15.5 9.5" stroke="currentColor" stroke-width={strokeWidth} stroke-linecap="round" stroke-linejoin="round" />
  </svg>
)}

{name === "truck" && (
  <svg viewBox="0 0 24 24" fill="none" class={className} id={id} xmlns="http://www.w3.org/2000/svg">
    <path d="M3 6.5H14V16H3V6.5Z" stroke="currentColor" stroke-width={strokeWidth} stroke-linejoin="round" />
    <path d="M14 10H17.5L20 13V16H14V10Z" stroke="currentColor" stroke-width={strokeWidth} stroke-linejoin="round" />
    <circle cx="7" cy="17.5" r="1.6" stroke="currentColor" stroke-width={strokeWidth} />
    <circle cx="16.5" cy="17.5" r="1.6" stroke="currentColor" stroke-width={strokeWidth} />
  </svg>
)}

{name === "refresh" && (
  <svg viewBox="0 0 24 24" fill="none" class={className} id={id} xmlns="http://www.w3.org/2000/svg">
    <path d="M5 9C6 6 8.8 4 12 4C16 4 19 7 19 11C19 15 16 18 12 18C9.2 18 6.7 16.4 5.5 14" stroke="currentColor" stroke-width={strokeWidth} stroke-linecap="round" />
    <path d="M5 5V9H9" stroke="currentColor" stroke-width={strokeWidth} stroke-linecap="round" stroke-linejoin="round" />
  </svg>
)}

{name === "chevron-left" && (
  <svg viewBox="0 0 24 24" fill="none" class={className} id={id} xmlns="http://www.w3.org/2000/svg">
    <path d="M15 5L8 12L15 19" stroke="currentColor" stroke-width={strokeWidth} stroke-linecap="round" stroke-linejoin="round" />
  </svg>
)}

{name === "chevron-right" && (
  <svg viewBox="0 0 24 24" fill="none" class={className} id={id} xmlns="http://www.w3.org/2000/svg">
    <path d="M9 5L16 12L9 19" stroke="currentColor" stroke-width={strokeWidth} stroke-linecap="round" stroke-linejoin="round" />
  </svg>
)}

{name === "zoom-in" && (
  <svg viewBox="0 0 24 24" fill="none" class={className} id={id} xmlns="http://www.w3.org/2000/svg">
    <circle cx="10.5" cy="10.5" r="6.5" stroke="currentColor" stroke-width={strokeWidth} />
    <path d="M19.5 19.5L15.5 15.5" stroke="currentColor" stroke-width={strokeWidth} stroke-linecap="round" />
    <path d="M10.5 7.5V13.5" stroke="currentColor" stroke-width={strokeWidth} stroke-linecap="round" />
    <path d="M7.5 10.5H13.5" stroke="currentColor" stroke-width={strokeWidth} stroke-linecap="round" />
  </svg>
)}

{name === "minus" && (
  <svg viewBox="0 0 24 24" fill="none" class={className} id={id} xmlns="http://www.w3.org/2000/svg">
    <path d="M5 12H19" stroke="currentColor" stroke-width={strokeWidth} stroke-linecap="round" />
  </svg>
)}

{name === "plus" && (
  <svg viewBox="0 0 24 24" fill="none" class={className} id={id} xmlns="http://www.w3.org/2000/svg">
    <path d="M12 5V19" stroke="currentColor" stroke-width={strokeWidth} stroke-linecap="round" />
    <path d="M5 12H19" stroke="currentColor" stroke-width={strokeWidth} stroke-linecap="round" />
  </svg>
)}

{name === "check" && (
  <svg viewBox="0 0 24 24" fill="none" class={className} id={id} xmlns="http://www.w3.org/2000/svg">
    <path d="M4.5 12.5L9.5 17.5L19.5 6.5" stroke="currentColor" stroke-width={strokeWidth} stroke-linecap="round" stroke-linejoin="round" />
  </svg>
)}