---
import type { CategoryPoster } from "../data/CategoryPosters";

export interface Props {
  posters: CategoryPoster[];
}

const { posters } = Astro.props;
---

<div class="grid grid-cols-1 sm:grid-cols-3 gap-3 sm:gap-4 md:gap-5">
  {posters.map((poster) => (
    <a
      href={poster.href}
      class="category-poster group relative aspect-[4/5] sm:aspect-[3/4] overflow-hidden border-2 border-ink block"
      aria-label={`Lihat koleksi ${poster.label}`}
    >
      <img
        src={poster.image}
        alt={poster.label}
        loading="lazy"
        class="w-full h-full object-cover transition-transform duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-105"
      />
      <div class="absolute inset-0 bg-ink/20 group-hover:bg-ink/35 transition-colors duration-300"></div>

      <span class="absolute bottom-4 left-4 sm:bottom-5 sm:left-5 font-display text-2xl sm:text-3xl md:text-4xl text-paper leading-none">
        {poster.label}
      </span>

      <span class="absolute top-4 right-4 sm:top-5 sm:right-5 w-9 h-9 sm:w-10 sm:h-10 flex items-center justify-center bg-paper border-2 border-ink text-ink opacity-0 -translate-y-1 group-hover:opacity-100 group-hover:translate-y-0 transition-all duration-200">
        <svg viewBox="0 0 24 24" class="w-4 h-4 sm:w-5 sm:h-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M7 17 17 7M7 7h10v10" />
        </svg>
      </span>
    </a>
  ))}
</div>

<style>
  @media (prefers-reduced-motion: reduce) {
    .category-poster img {
      transition: none;
    }
  }
</style>